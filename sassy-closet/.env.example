# Grok Bot routine: intake-dataset-sync-webhook
# Immediate path after GF create/update persist.
# Poll backup already exists on Grok Bot — Mini Boss does not need to be online.
# Boss pastes both from the desktop routine panel. Never commit real values.
# Vercel → intake project (sassy-closet.vercel.app) → Environment Variables
# (Production + Preview as needed) → Redeploy intake only. Do not set on sell-test.
#
# Both must be set or the helper no-ops (GF save still succeeds).
# Auth header: Authorization: Bearer <INTAKE_DATASET_SYNC_WEBHOOK_KEY>
# Optional duplicate: X-Automation-Key: <same key>
# Key is often prefixed crsr_. Never log the raw key.
#
# Shop tools (intake /admin/shop). Names only. Never commit values.
# SHOP_BLOB_READ_WRITE_TOKEN is the shop Blob store token, not this app's BLOB_READ_WRITE_TOKEN.
# SHOP_REVALIDATE_URL example: https://sassycloset.vercel.app/api/admin/revalidate
# Header sent to the shop: x-shop-revalidate-secret
# Local catalog file (ignored on Vercel): SHOP_CATALOG_FILE=

ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
SHOP_BLOB_READ_WRITE_TOKEN=
SHOP_REVALIDATE_SECRET=
SHOP_REVALIDATE_URL=

# Full Grok Bot webhook POST URL from the routine panel
INTAKE_DATASET_SYNC_WEBHOOK_URL=

# Sender key from the routine panel. Used as Authorization: Bearer <key>
INTAKE_DATASET_SYNC_WEBHOOK_KEY=
