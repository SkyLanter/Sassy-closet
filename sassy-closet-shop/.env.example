# Local / Vercel. Never put real tokens in git.
# Set the same names on the Vercel project (Production + Preview).
# Admin sign-in is fail-closed. Names and steps: docs/ADMIN_ACCESS.md
# Required names: ADMIN_PASSWORD and ADMIN_SESSION_SECRET (values only in Vercel).
# Local (off Vercel) Add/Save persist to data/live-catalog.json.

# Blob/KV prefix. TEST default: sassy-closet-shop
# Official clone: sassy-closet-official (new Vercel project — see docs/OFFICIAL_CLONE.md)
SITE_ID=sassy-closet-shop
NEXT_PUBLIC_SITE_ID=sassy-closet-shop

# test = HTML noindex. official = index/follow (new domain only).
NEXT_PUBLIC_SITE_MODE=test

# Public shop origin for canonical, OG, sitemap, and share URLs. Leave empty locally. No trailing slash.
# Production customer host is https://sassycloset.vercel.app. The older alias sassy-closet-shop.vercel.app still serves this app.
NEXT_PUBLIC_SHOP_URL=

# Public Facebook Page URL. Message CTA becomes https://m.me/{id} with no ?text=.
NEXT_PUBLIC_MESSENGER_URL=https://www.facebook.com/profile.php?id=61594312648057

# Preferred live catalog JSON + image uploads (Vercel Blob).
BLOB_READ_WRITE_TOKEN=

# Catalog-only fallback if Blob is unset (both required together).
KV_REST_API_URL=
KV_REST_API_TOKEN=
