# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
/agent-tools

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit secrets
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local sell-test catalog + uploads (not the seed)
/data/live-catalog.json
/data/backups/*.json
/public/uploads/

# Intake app + Official Excel stay out of this shop (Excel / OneDrive read-only)
/sassy-closet/
/excel-kit/

__pycache__/
*.pyc
